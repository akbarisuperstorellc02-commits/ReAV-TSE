{
  "name": "reav-tse-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.7",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "@fontsource/noto-sans-arabic": "^5.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.0",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.reavtse.desktop",
    "productName": "ReAV-TSE",
    "directories": {
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/reav_backend",
        "to": "backend"
      },
      {
        "from": "../backend/model_cache/checkpoints",
        "to": "checkpoints"
      },
      {
        "from": "../backend/model_cache/torch_cache",
        "to": "torch_cache"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ReAV-TSE-Setup-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ReAV-TSE"
    }
  }
}
